 #ifdef FF_PREFIX_DIR
-  EnvironmentInsert("init-files",string(FF_PREFIX_DIR) + "/etc/" + ffpref  ,"$");
+  {
+    // conda-forge: FF_PREFIX_DIR is relocated in the binary at install time (shorter path,
